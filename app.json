{
  "expo": {
    "name": "Cia do Ar",
    "slug": "laudo-voo",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "laudovoo",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laudovoo.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos da câmera para fotografar o equipamento.",
        "NSPhotoLibraryUsageDescription": "Precisamos da galeria para selecionar fotos do equipamento."
      }
    },
    "android": {
      "package": "com.laudovoo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos da galeria para selecionar fotos do equipamento.",
          "cameraPermission": "Precisamos da câmera para fotografar o equipamento."
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5782bfd6-c4af-4c71-9474-601d6a9ca2cf"
      }
    }
  }
}
